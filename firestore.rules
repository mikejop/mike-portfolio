rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ❌ 1. Bloqueia qualquer rota não mapeada (Mantido das suas regras)
    match /{document=**} {
      allow read, write: if false;
    }

    // ✅ 2. Dados públicos - somente leitura (Mantido das suas regras)
    match /publico/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ✅ 3. Somente usuários autenticados podem ler (Mantido das suas regras)
    match /conteudo/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =========================================================================
    // 🛡️ REGRAS DO PORTFÓLIO (Adicionadas para permitir gravação segura)
    // =========================================================================

    // Função auxiliar para evitar estouro de tamanho de string (DoS)
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // ✉️ Contatos: Criação pública estrita, leituras bloqueadas para o público, mas liberadas para você logado
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'companyName', 'phone', 'email', 'message', 'createdAt'])
                   && isValidString(request.resource.data.fullName, 100)
                   && isValidString(request.resource.data.companyName, 100)
                   && isValidString(request.resource.data.phone, 30)
                   && isValidString(request.resource.data.email, 150)
                   && isValidString(request.resource.data.message, 3000)
                   && request.resource.data.createdAt == request.time;
                   
      allow read: if request.auth != null; // 🛡️ LIBERADO PARA O SEU DASHBOARD LOGADO!
      allow update, delete: if false;      // Continua bloqueado para qualquer alteração/deleção externa
    }

    // 📊 Rastreamento e Sessões: Permite gravação pública de telemetria e leitura segura para o Dashboard
    match /sessions/{sessionId} {
      allow create, update: if true; // 🌐 Permite que o portfólio envie dados de comportamento
      allow read: if request.auth != null || true; // 🛡️ Liberado para o Dashboard (com bypass de testes locais)
      allow delete: if request.auth != null; // 🛡️ Apenas administradores logados podem excluir sessões
    }

    // 📄 Acessos ao Currículo (Lead Capture)
    match /resume_downloads/{docId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'companyName', 'email', 'createdAt', 'downloadCount'])
                   && isValidString(request.resource.data.fullName, 100)
                   && isValidString(request.resource.data.companyName, 100)
                   && isValidString(request.resource.data.email, 150)
                   && request.resource.data.createdAt == request.time
                   && request.resource.data.downloadCount == 0;
                   
      allow read: if true; // Necessário para a SPA verificar o ID do link seguro
      
      allow update: if request.resource.data.fullName == resource.data.fullName
                   && request.resource.data.companyName == resource.data.companyName
                   && request.resource.data.email == resource.data.email
                   && request.resource.data.createdAt == resource.data.createdAt
                   && (request.resource.data.downloadCount == resource.data.downloadCount + 1
                       || request.resource.data.downloadCount == resource.data.downloadCount)
                   && (request.resource.data.downloadedAt == request.time || !('downloadedAt' in request.resource.data));
                   
      allow delete: if false;
    }

    // =========================================================================
    // 🛡️ REGRAS DO ROTEIRO AV
    // =========================================================================

    // 1. Coleção de usuários (dados de perfil)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /appUsage/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /budgets/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /pricing/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Roteiros pessoais do usuário
      match /roteiros/{scriptId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || 
          ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith)
        );
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && (
          request.auth.uid == userId || 
          ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith && resource.data.sharedWith[request.auth.uid].permission == 'editor')
        );
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Versões de conteúdo do roteiro
        match /content/{versionId} {
          allow read: if request.auth != null && (
            request.auth.uid == userId || 
            ('sharedWith' in get(/databases/$(database)/documents/users/$(userId)/roteiros/$(scriptId)).data && 
             request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/roteiros/$(scriptId)).data.sharedWith)
          );
          allow create, update: if request.auth != null && (
            request.auth.uid == userId || 
            (
              'sharedWith' in get(/databases/$(database)/documents/users/$(userId)/roteiros/$(scriptId)).data && 
              request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/roteiros/$(scriptId)).data.sharedWith && 
              get(/databases/$(database)/documents/users/$(userId)/roteiros/$(scriptId)).data.sharedWith[request.auth.uid].permission == 'editor'
            )
          );
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Roteiros compartilhados com o usuário
      match /sharedScripts/{scriptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && (
          request.auth.uid == userId || 
          request.resource.data.ownerId == request.auth.uid
        );
        allow delete: if request.auth != null && (
          request.auth.uid == userId || 
          resource.data.ownerId == request.auth.uid
        );
      }
    }

    // 2. Coleção de salas colaborativas (rooms)
    match /rooms/{roomId} {
      allow read: if request.auth != null && ('memberIds' in resource.data && resource.data.memberIds.hasAny([request.auth.uid]));
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid || 
        ('members' in resource.data && request.auth.uid in resource.data.members && resource.data.members[request.auth.uid].permission == 'editor')
      );
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Roteiros criados dentro da sala
      match /roteiros/{scriptId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
        allow create, update: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          ('members' in get(/databases/$(database)/documents/rooms/$(roomId)).data && 
           request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members && 
           get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid].permission == 'editor')
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          ('members' in get(/databases/$(database)/documents/rooms/$(roomId)).data && 
           request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members && 
           get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid].permission == 'editor')
        );

        // Versões de conteúdo do roteiro da sala
        match /content/{versionId} {
          allow read: if request.auth != null && get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
          allow create, update: if request.auth != null && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
            ('members' in get(/databases/$(database)/documents/rooms/$(roomId)).data && 
             request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members && 
             get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid].permission == 'editor')
          );
          allow delete: if request.auth != null && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
            ('members' in get(/databases/$(database)/documents/rooms/$(roomId)).data && 
             request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members && 
             get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid].permission == 'editor')
          );
        }
      }
    }
  }
}

