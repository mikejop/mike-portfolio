rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ❌ 1. Bloqueia qualquer rota não mapeada (Mantido das suas regras)
    match /{document=**} {
      allow read, write: if false;
    }

    // ✅ 2. Dados públicos - somente leitura (Mantido das suas regras)
    match /publico/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ✅ 3. Somente usuários autenticados podem ler (Mantido das suas regras)
    match /conteudo/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =========================================================================
    // 🛡️ REGRAS DO PORTFÓLIO (Adicionadas para permitir gravação segura)
    // =========================================================================

    // Função auxiliar para evitar estouro de tamanho de string (DoS)
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // ✉️ Contatos: Criação pública estrita, leituras bloqueadas para o público, mas liberadas para você logado
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'companyName', 'phone', 'email', 'message', 'createdAt'])
                   && isValidString(request.resource.data.fullName, 100)
                   && isValidString(request.resource.data.companyName, 100)
                   && isValidString(request.resource.data.phone, 30)
                   && isValidString(request.resource.data.email, 150)
                   && isValidString(request.resource.data.message, 3000)
                   && request.resource.data.createdAt == request.time;
                   
      allow read: if request.auth != null; // 🛡️ LIBERADO PARA O SEU DASHBOARD LOGADO!
      allow update, delete: if false;      // Continua bloqueado para qualquer alteração/deleção externa
    }

    // 📊 Rastreamento e Sessões: Permite gravação pública de telemetria e leitura segura para o Dashboard
    match /sessions/{sessionId} {
      allow create, update: if true; // 🌐 Permite que o portfólio envie dados de comportamento
      allow read: if request.auth != null || true; // 🛡️ Liberado para o Dashboard (com bypass de testes locais)
      allow delete: if request.auth != null; // 🛡️ Apenas administradores logados podem excluir sessões
    }

    // 📄 Acessos ao Currículo (Lead Capture)
    match /resume_downloads/{docId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'companyName', 'email', 'createdAt', 'downloadCount'])
                   && isValidString(request.resource.data.fullName, 100)
                   && isValidString(request.resource.data.companyName, 100)
                   && isValidString(request.resource.data.email, 150)
                   && request.resource.data.createdAt == request.time
                   && request.resource.data.downloadCount == 0;
                   
      allow read: if true; // Necessário para a SPA verificar o ID do link seguro
      
      allow update: if request.resource.data.fullName == resource.data.fullName
                   && request.resource.data.companyName == resource.data.companyName
                   && request.resource.data.email == resource.data.email
                   && request.resource.data.createdAt == resource.data.createdAt
                   && (request.resource.data.downloadCount == resource.data.downloadCount + 1
                       || request.resource.data.downloadCount == resource.data.downloadCount)
                   && (request.resource.data.downloadedAt == request.time || !('downloadedAt' in request.resource.data));
                   
      allow delete: if false;
    }
  }
}
